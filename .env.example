# Copy to .env and run with `node --env-file=.env src/index.ts`.
# Every variable is optional; the defaults shown are what the bot uses.

# Desk REST base URL. http://localhost:4000 for a local desk.
BOT_API_URL=https://api.devnet.cessio.cc

# Registration display name — the desk derives the party hint from it.
BOT_DISPLAY_NAME=Cessio Demo Maker

# Half-spread vs the reference mid, in basis points.
BOT_SPREAD_BPS=20

# Identity persistence (party key + API key). Losing it loses the party.
BOT_STATE_FILE=state/identity.json

# Housekeeping cadence in seconds: /tx/pending, /wallet/incoming, faucet.
BOT_POLL_SECONDS=10

# Fallback mids when the desk has no reference price, e.g. cbtc/usdcx:97000,ceth/cc:1200
BOT_STATIC_PRICES=

# Largest share of a holding one trade may commit (0..1].
BOT_MAX_SPEND_SHARE=0.5

# Divide every mid by this. 1 = real prices; 100 = prices faucet money affords.
BOT_PRICE_DIVISOR=1

# How long a quote stands, capped by the RFQ deadline.
BOT_QUOTE_TTL_SECONDS=300
